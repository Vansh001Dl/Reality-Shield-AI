# RealityShield-AI Production Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ==============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application settings
APP_NAME=RealityShield-AI
APP_ENV=development
DEBUG=false
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Use SQLite for local development unless a production Postgres instance is configured.
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/realityshield

# Frontend Configuration
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://yourdomain.com,https://app.yourdomain.com

# Security
SECRET_KEY=your_super_secret_key_here_use_a_long_random_string
API_KEY=your_api_key_here_use_a_long_random_string

# ==============================================================================
# AI MODEL CONFIGURATION
# =============================================================================

# API Keys for AI services (should be set via environment in production)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Optional hosted Roboflow model (use a model ID such as road-safety/1)
ROBOFLOW_MODEL_ID=
ROBOFLOW_API_URL=https://detect.roboflow.com

# Model settings
YOLO_MODEL_PATH=./ml_models/yolo_weights/best.pt
RISK_MODEL_PATH=./ml_models/risk_model.pkl
DEFAULT_YOLO_WEIGHTS=yolov8n.pt

# ==============================================================================
# CLOUD & STORAGE CONFIGURATION
# =============================================================================

# AWS S3 for video storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_BUCKET_NAME=realityshield-videos
S3_VIDEO_STORAGE_PREFIX=videos
S3_DATASET_STORAGE_PREFIX=datasets

# ==============================================================================
# MONITORING & LOGGING
# =============================================================================

# Monitoring services
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log

# ==============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# Rate limiting
RATE_LIMIT=1000
RATE_LIMIT_WINDOW=60

# Background workers (set CELERY_ENABLED=true only when a Celery worker is running)
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Session settings
SESSION_TIMEOUT=3600

# ==============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Email service (for alerts)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=your_email@yourdomain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=alerts@yourdomain.com

# ==============================================================================
# DEVELOPMENT OVERRIDES (use these in development)
# =============================================================================

# Development database (override production settings)
DEV_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/realityshield_dev

# Development API keys (for testing)
DEV_GROQ_API_KEY=gsk_test_key_for_development_only
DEV_GEMINI_API_KEY=your_gemini_test_key

# Debug settings
DEV_DEBUG=true
DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEV_LOG_LEVEL=DEBUG
